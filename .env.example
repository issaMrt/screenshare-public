# Copie ce fichier en .env et renseigne tes propres valeurs.
# Le fichier .env ne doit jamais être commit sur GitHub (voir .gitignore).

# Token secret pour accéder à la page émetteur (/sender?token=...)
# Choisis une chaîne longue et difficile à deviner.
BROADCASTER_TOKEN=

# Port local du serveur (optionnel, 3000 par défaut)
PORT=3000

# Domaine ngrok si tu utilises un tunnel public (optionnel)
# Exemple : mon-tunnel.ngrok-free.app
NGROK_DOMAIN=

# Nombre maximum de spectateurs simultanés (optionnel, 10 par défaut)
MAX_VIEWERS=10

# Nombre maximum de connexions WebSocket par IP (optionnel, 8 par défaut)
MAX_CONNECTIONS_PER_IP=8
